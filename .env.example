DATABASE_URL=sqlite:///./econova.db
# Local SQLite mode generates an ephemeral process-local signing key if blank.
# For PostgreSQL/shared deployments, set a unique random value of at least 32 characters.
SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PROVIDER_HTTP_LOCAL_ADDRESS=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=/api/v1
# Docker Compose only: set a URL-safe password before starting the stack.
POSTGRES_PASSWORD=
